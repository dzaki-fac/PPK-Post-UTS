# Salin menjadi '.env' di dalam folder functions/ untuk menjalankan backend secara lokal.
# JANGAN PERNAH meng-commit file '.env' asli atau menaruh server key di client React Native!

PORT=8080

# Firebase Admin SDK (pilih salah satu cara autentikasi):
# 1. Path ke file service account JSON (lokal)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# 2. Atau isi JSON service account dalam satu baris (untuk Render / Railway / Cloud)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=praktikum-ppk-labportal

# Midtrans Sandbox Credentials (dapatkan di Midtrans Sandbox Dashboard -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_WITH_YOUR_SANDBOX_SERVER_KEY
MIDTRANS_BASE_URL_SNAP=https://app.sandbox.midtrans.com
MIDTRANS_BASE_URL_API=https://api.sandbox.midtrans.com

# Opsional: URL callback selesai di sisi client/web
MIDTRANS_FINISH_REDIRECT_URL=https://labportal.local/praktikan/pembayaran-hasil
