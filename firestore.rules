rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mengambil dokumen user untuk mengecek peran (Role-Based Access Control)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return isAuthenticated() && getUserData().peran == 'asisten';
    }

    function isPraktikan() {
      return isAuthenticated() && getUserData().peran == 'praktikan';
    }

    // -------------------------------------------------------------------------
    // 1. Koleksi: users (/users/{uid})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Siapapun yang login dapat membaca profil untuk keperluan identitas & roster
      allow read: if isAuthenticated();
      // Pengguna dapat menyunting profil miliknya sendiri, dan Asisten dapat mengelola master data praktikan
      allow create, update: if isOwner(userId) || isAsisten();
      // Asisten dapat menghapus akun praktikan/asisten melalui Master Data
      allow delete: if isAsisten() || isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // 2. Koleksi: sessions (/sessions/{sessionId})
    // -------------------------------------------------------------------------
    match /sessions/{sessionId} {
      // Semua pengguna terautentikasi dapat melihat jadwal praktikum
      allow read: if isAuthenticated();
      // Hanya Asisten Laboratorium yang dapat menambah, membuka, menutup, atau menghapus sesi
      allow create, update, delete: if isAsisten();
    }

    // -------------------------------------------------------------------------
    // 3. Koleksi: attendances (/attendances/{attendanceId})
    // Format ID: `${sessionId}_${studentId}`
    // ===== P3 ===== (Sprint 4: status kehadiran final & denda ditentukan backend)
    // -------------------------------------------------------------------------
    match /attendances/{attendanceId} {
      // Praktikan dan Asisten dapat melihat rekap presensi
      allow read: if isAuthenticated();

      // Praktikan hanya dapat membuat presensi miliknya dengan status hadir/terlambat
      // dan tanpa fineId (tagihan hanya diterbitkan Cloud Functions).
      // Asisten (asprak) dapat membuat presensi manual / izin.
      allow create: if isAuthenticated() && (
        (isPraktikan()
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.attendanceStatus in ['hadir', 'terlambat']
          && !('fineId' in request.resource.data))
        || isAsisten()
      );

      // Client tidak boleh mengubah presensi yang sudah tercatat (anti-tamper).
      allow update: if false;
      // Hapus hanya untuk staf (dibutuhkan hapus-sesi yang ikut menghapus presensinya).
      allow delete: if isAsisten() || p3IsAslab();
    }

    // -------------------------------------------------------------------------
    // 4. Koleksi: leave_requests (/leave_requests/{requestId})
    // -------------------------------------------------------------------------
    match /leave_requests/{requestId} {
      // Pengguna terautentikasi dapat membaca pengajuan izin
      allow read: if isAuthenticated();

      // Praktikan dapat membuat pengajuan izin untuk dirinya sendiri (studentId == auth.uid)
      // atau Asisten dapat menginputkan izin praktikan
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAsisten()
      );

      // Pembaruan keputusan status (disetujui/ditolak) hanya boleh dilakukan oleh Asisten
      allow update: if isAsisten();
      allow delete: if isAsisten();
    }

    // -------------------------------------------------------------------------
    // 5. Koleksi labs (/labs/{labId}) — Sprint 3
    // Read untuk semua pengguna terautentikasi, tulis hanya Asisten.
    // -------------------------------------------------------------------------
    match /labs/{labId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAsisten();
    }

    // -------------------------------------------------------------------------
    // 6. Koleksi notifications (/notifications/{notificationId}) — Sprint 3
    // Log peristiwa dibuat oleh aplikasi, hanya pemilik yang dapat membaca
    // dan menandai isRead.
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 7. ===== P3 ===== Koleksi keuangan Sprint 4 (fines, payments, payment_events)
    // Seluruh penulisan HANYA lewat Admin SDK (Cloud Functions). Client hanya membaca.
    // -------------------------------------------------------------------------
    function p3IsAslab() {
      return isAuthenticated() && getUserData().peran == 'aslab';
    }

    function p3ManagesCourse(courseId) {
      return p3IsAslab() && courseId in getUserData().get('managedCourseIds', []);
    }

    match /fines/{fineId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || p3ManagesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || p3ManagesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 8. Koleksi Sistem / Health Check (untuk verifikasi koneksi)
    // -------------------------------------------------------------------------
    match /system_health/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}

