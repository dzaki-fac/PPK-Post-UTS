rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // Stage 0 Shared Helper Functions (SRS4.md §3.11)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(userDocPath());
    }

    function getUserData() {
      return get(userDocPath()).data;
    }

    function isAslab() {
      return hasUserDoc() && getUserData().peran == 'aslab';
    }

    function isAsprak() {
      return hasUserDoc() && (
        getUserData().peran == 'asprak' || getUserData().peran == 'asisten'
      );
    }

    // Kompatibilitas helper Sprint 2-3
    function isAsisten() {
      return isAsprak();
    }

    function isPraktikan() {
      return hasUserDoc() && getUserData().peran == 'praktikan';
    }

    function managesCourse(courseId) {
      return isAslab() && (
        !(getUserData().keys().hasAny(['managedCourseIds'])) ||
        getUserData().managedCourseIds.size() == 0 ||
        courseId in getUserData().managedCourseIds
      );
    }

    function teachesLab(labId) {
      return isAsprak() && (
        (getUserData().keys().hasAny(['labIds']) && labId in getUserData().labIds) ||
        (getUserData().keys().hasAny(['labId']) && getUserData().labId == labId)
      );
    }

    // ===== P1 =====
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Registrasi mandiri hanya boleh sebagai praktikan atau asprak (tidak boleh aslab).
      allow create: if isOwner(userId)
        && request.resource.data.peran in ['praktikan', 'asprak'];

      // Pemilik boleh menyunting profilnya tanpa mengubah peran menjadi aslab;
      // Aslab boleh memperbarui penugasan lab (labId, labIds, kelas) & metadata;
      // Asprak tetap kompatibel untuk data Sprint 2-3 non-aslab.
      allow update: if isAuthenticated() && (
        (isOwner(userId)
          && request.resource.data.peran == resource.data.peran
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managedCourseIds']))
        || (isAslab()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['labId', 'labIds', 'kelas', 'emailLower', 'updatedAt']))
        || (isAsprak() && resource.data.peran in ['praktikan', 'asprak', 'asisten'])
      );

      allow delete: if isAslab() || isOwner(userId);
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAslab();
      allow update, delete: if managesCourse(courseId);
    }

    match /labs/{labId} {
      allow read: if isAuthenticated();
      allow create: if isAslab()
        && (!request.resource.data.keys().hasAny(['courseId']) || managesCourse(request.resource.data.courseId));
      allow update, delete: if isAslab()
        && (!resource.data.keys().hasAny(['courseId']) || managesCourse(resource.data.courseId));
    }

    match /lab_members/{memberId} {
      allow read: if isAuthenticated() && (
        isAslab()
        || teachesLab(resource.data.labId)
        || resource.data.uid == request.auth.uid
        || (request.auth.token.email != null
          && resource.data.emailLower == request.auth.token.email.lower())
      );

      allow create, delete: if isAslab();

      allow update: if isAslab() || (
        isAuthenticated()
        && (resource.data.uid == null || !(resource.data.keys().hasAny(['uid'])))
        && request.auth.token.email != null
        && resource.data.emailLower == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'updatedAt'])
      );
    }

    match /lab_transfers/{transferId} {
      allow read: if isAslab();
      allow create: if isAslab();
      allow update, delete: if false;
    }

    match /import_batches/{batchId} {
      allow read: if isAslab();
      allow create: if isAslab();
      allow update, delete: if false;
    }

    // ===== P2 =====
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAslab() || isAsprak();
      allow update: if isAslab() || isAsprak();
      allow delete: if isAslab() || isAsprak();
    }

    match /leave_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAsprak() || isAslab()
      );
      allow update, delete: if isAsprak() || isAslab();
    }

    // ===== P3 =====
    match /attendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isPraktikan() && request.resource.data.studentId == request.auth.uid)
        || isAsprak()
        || isAslab()
      );
      allow update, delete: if isAsprak() || isAslab();
    }

    match /fines/{fineId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAslab()
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAslab()
      );
      allow write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Koleksi Sprint 3 yang Dipertahankan (notifications & system_health)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    match /system_health/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
