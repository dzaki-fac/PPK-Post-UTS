rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAslab() {
      return isAuthenticated() && getUserData().peran == 'aslab';
    }

    // Menerima 'asprak' dan nilai legacy 'asisten'
    function isAsprak() {
      return isAuthenticated() && (
        getUserData().peran == 'asprak' || getUserData().peran == 'asisten'
      );
    }

    // Alias kompatibilitas Sprint 2-3
    function isAsisten() {
      return isAsprak() || isAslab();
    }

    function isPraktikan() {
      return isAuthenticated() && getUserData().peran == 'praktikan';
    }

    function managesCourse(courseId) {
      return isAslab() && (
        !('managedCourseIds' in getUserData()) ||
        getUserData().managedCourseIds.size() == 0 ||
        courseId in getUserData().managedCourseIds
      );
    }

    function teachesLab(labId) {
      return isAsprak() && (
        !('labIds' in getUserData()) ||
        getUserData().labIds.size() == 0 ||
        labId in getUserData().labIds
      );
    }

    // ===== P1 =====
    // 1. Koleksi: users (/users/{uid})
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAslab();
      allow update: if isOwner(userId) || isAslab();
      allow delete: if isAslab() || isOwner(userId);
    }

    // 2. Koleksi: courses (/courses/{courseId})
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAslab();
    }

    // 3. Koleksi: labs (/labs/{labId})
    match /labs/{labId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAslab();
    }

    // 4. Koleksi: lab_members (/lab_members/{memberId})
    match /lab_members/{memberId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAslab();
      allow update: if isAslab() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.emailLower == request.auth.token.email.lower()
      );
    }

    // 5. Koleksi audit P1: lab_transfers & import_batches
    match /lab_transfers/{transferId} {
      allow read: if isAslab();
      allow create: if isAslab();
      allow update, delete: if false;
    }

    match /import_batches/{batchId} {
      allow read: if isAslab();
      allow create: if isAslab();
      allow update, delete: if false;
    }

    // ===== P2 =====
    // 6. Koleksi: sessions (/sessions/{sessionId})
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAslab();
      allow update: if isAslab() || (
        isAsprak() &&
        (!('labId' in resource.data) || teachesLab(resource.data.labId)) &&
        (!('startedAt' in resource.data) || request.resource.data.startedAt == resource.data.startedAt) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'openedAt',
          'closedAt',
          'startedAt',
          'kodeSesi',
          'qrPayload',
          'updatedAt'
        ])
      );
    }

    // 7. Koleksi: attendances (/attendances/{attendanceId})
    // Format ID: `${sessionId}_${studentId}` — tidak ada update/delete dari client
    match /attendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isPraktikan() &&
          request.resource.data.studentId == request.auth.uid &&
          !('fineId' in request.resource.data) &&
          (!('attendanceStatus' in request.resource.data) ||
            request.resource.data.attendanceStatus in ['hadir', 'terlambat'])) ||
        (isAsprak() && (
          request.resource.data.attendanceStatus == 'izin' ||
          request.resource.data.verificationMethod == 'manual-asprak'
        ))
      );
      allow update, delete: if false;
    }

    // 8. Koleksi: leave_requests (/leave_requests/{requestId})
    match /leave_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAsisten()
      );
      allow update, delete: if isAsisten();
    }

    // ===== P3 =====
    // 9. Koleksi: fines & payments (hanya Admin SDK yang boleh menulis)
    match /fines/{fineId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        managesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        managesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    // 10. Koleksi: notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // 11. Koleksi Sistem / Health Check
    match /system_health/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
