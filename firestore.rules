rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================
    // Stage 0 Shared Helpers (SRS4.md §3.11)
    // =========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isAslab() {
      return hasUserDoc() && userData().peran == 'aslab';
    }

    function isAsprak() {
      return hasUserDoc() && (userData().peran == 'asprak' || userData().peran == 'asisten');
    }

    function isPraktikan() {
      return hasUserDoc() && userData().peran == 'praktikan';
    }

    function isStaff() {
      return isAslab() || isAsprak();
    }

    function managesCourse(courseId) {
      return isAslab() && (
        !(userData().keys().hasAny(['managedCourseIds'])) ||
        userData().managedCourseIds.size() == 0 ||
        courseId in userData().managedCourseIds
      );
    }

    function teachesLab(labId) {
      return isAsprak() && (
        (userData().keys().hasAny(['labIds']) && labId in userData().labIds) ||
        (userData().keys().hasAny(['labId']) && userData().labId == labId)
      );
    }

    // ===== P1 =====
    match /users/{userId} {
      allow read: if isSignedIn();
      // Self-registration hanya boleh sebagai praktikan atau asprak (tidak boleh aslab).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.peran in ['praktikan', 'asprak'];
      // Update profil sendiri tanpa mengubah peran menjadi aslab, atau dikelola Aslab / Asprak terdaftar.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.peran == resource.data.peran)
        || isAslab()
        || (isAsprak() && resource.data.peran in ['praktikan', 'asprak', 'asisten'])
      );
      allow delete: if isAslab();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isAslab();
      allow update, delete: if managesCourse(courseId);
    }

    match /labs/{labId} {
      allow read: if isSignedIn();
      allow create: if isAslab();
      allow update, delete: if isAslab()
        && (!resource.data.keys().hasAny(['courseId']) || managesCourse(resource.data.courseId));
    }

    match /lab_members/{memberId} {
      // Praktikan & Asprak bisa membaca agar proses linking saat login berjalan tanpa hambatan.
      allow read: if isSignedIn();
      allow create, delete: if isAslab();
      allow update: if isAslab() || (
        isSignedIn()
        && resource.data.uid == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.labId == resource.data.labId
        && request.resource.data.courseId == resource.data.courseId
      );
    }

    match /lab_transfers/{transferId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.memberId == request.auth.uid);
      allow create: if isAslab();
      allow update, delete: if false;
    }

    match /import_batches/{batchId} {
      allow read: if isAslab();
      allow create: if isAslab();
      allow update, delete: if false;
    }

    // ===== P2 =====
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isAslab() || (isAsprak() && (
        !resource.data.keys().hasAny(['labId']) || teachesLab(resource.data.labId) || resource.data.asistenId == request.auth.uid
      ));
      allow delete: if isAslab() || (isAsprak() && resource.data.asistenId == request.auth.uid);
    }

    match /leave_requests/{leaveId} {
      allow read: if isSignedIn() && (
        isStaff() || resource.data.mahasiswaId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.mahasiswaId == request.auth.uid;
      allow update: if isStaff() || (
        isSignedIn() && resource.data.mahasiswaId == request.auth.uid
      );
      allow delete: if isStaff();
    }

    // ===== P3 =====
    // Presensi Sprint 4 (dari main): status final & denda ditentukan backend.
    // Format ID: `${sessionId}_${studentId}`
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      // Praktikan hanya boleh membuat presensi miliknya (hadir/terlambat, tanpa fineId).
      // Staf boleh membuat presensi manual / izin.
      allow create: if isSignedIn() && (
        (isPraktikan()
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.attendanceStatus in ['hadir', 'terlambat']
          && !('fineId' in request.resource.data))
        || isStaff()
      );
      // Client tidak boleh mengubah presensi yang sudah tercatat (anti-tamper).
      allow update: if false;
      // Hapus hanya untuk staf (hapus-sesi ikut menghapus presensinya).
      allow delete: if isStaff();
    }

    // Koleksi lama dari branch ini. Hapus blok ini kalau kode sudah tidak memakai `attendance`.
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isStaff() || resource.data.mahasiswaId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.mahasiswaId == request.auth.uid || isStaff()
      );
      allow update: if isSignedIn() && (
        resource.data.mahasiswaId == request.auth.uid || isStaff()
      );
      allow delete: if isStaff();
    }

    // Keuangan Sprint 4: penulisan HANYA lewat Admin SDK (Cloud Functions).
    match /fines/{fineId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || managesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || managesCourse(resource.data.courseId)
      );
      allow write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAslab()
      );
    }

    // Koleksi sistem / health check (dari main)
    match /system_health/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}