# ==============================================================================
# PPK LabPortal — Environment Configuration Template
# Salin berkas ini menjadi '.env' di komputer lokal Anda:
# cp .env.example .env
#
# Catatan: Variabel dengan prefix EXPO_PUBLIC_ otomatis dapat dibaca oleh
# aplikasi Expo / React Native di sisi client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Firebase (Disediakan oleh Project Manager dari Firebase Console)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyFromFirebaseConsole123456
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ppk-labportal.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ppk-labportal
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ppk-labportal.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


